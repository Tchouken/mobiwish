# =========================================================
#  Installation sur place (mini-PC, VPS) — valeurs par defaut
# =========================================================
PORT=3000
# URL publique de l'evenement : elle alimente le QR code affiche sur place
PUBLIC_URL=http://localhost:3000

# --- Securite ---
# Secret de signature des sessions participants (obligatoire en production)
SESSION_SECRET=change-me-please
# Code d'acces a la console d'administration (/admin)
ADMIN_TOKEN=leboncoin2026
# Code d'acces optionnel a la borne : /kiosk?kiosk=CODE (memorise sur l'iPad)
KIOSK_TOKEN=

# --- Base de donnees ---
# sqlite (defaut) : un fichier local, pour un serveur durable.
# postgres        : obligatoire en serverless ou multi-instances.
DB_DRIVER=sqlite
# Chaine de connexion PostgreSQL *avec pooling* (Neon, Supabase, RDS…)
# DATABASE_URL=postgres://user:mot-de-passe@hote/base?sslmode=require
AUTO_MIGRATE=1

# --- Stockage des images ---
# disk (defaut) : dossier local servi par l'application.
# blob          : Vercel Blob (obligatoire en serverless).
STORAGE_DRIVER=disk
DATA_DIR=./data
# BLOB_READ_WRITE_TOKEN=
# public (defaut) ou private, selon le store Vercel Blob cree.
# En prive, les images sont relayees par l'application (URL /media/...).
# BLOB_ACCESS=public

# --- Generation d'images ---
# mock   : generateur local, aucune cle (demo, repetition, repli)
# gemini : API Google Generative Language
# openai : API images OpenAI
IMAGE_PROVIDER=mock

# Google Gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 1:1 (galerie carree), 4:3, 16:9…
GEMINI_IMAGE_ASPECT=1:1

# OpenAI
OPENAI_API_KEY=
# gpt-image-1 est retire le 23/10/2026 : utiliser un modele courant
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1024
# low | medium | high — pese directement sur le cout et la duree
OPENAI_IMAGE_QUALITY=medium
IMAGE_TIMEOUT_MS=90000
# Repli automatique sur le generateur local si l'API distante echoue (1 = oui)
IMAGE_FALLBACK_MOCK=1
IMAGE_STYLE=illustration editoriale moderne, formes geometriques simples, aplats de couleurs vives dominante orange, fond clair, sans texte

# --- Comportement d'execution ---
# inline  : generation en tache de fond des la creation (serveur durable)
# request : generation declenchee par POST /api/projects/:id/render (serverless)
RENDER_MODE=inline
# sse  : flux temps reel /api/events   |   poll : interrogation periodique
REALTIME=sse
POLL_INTERVAL_MS=5000
# Duree de cache CDN des reponses publiques, en secondes (0 = pas de cache)
PUBLIC_CACHE_SECONDS=0

# =========================================================
#  Hebergement Vercel — variables a definir dans le projet
# =========================================================
# PUBLIC_URL=https://votre-projet.vercel.app
# SESSION_SECRET=<chaine aleatoire de 32+ caracteres>
# ADMIN_TOKEN=<code d'acces admin>
# DATABASE_URL=<chaine PostgreSQL pooled, fournie par l'integration Neon>
# BLOB_READ_WRITE_TOKEN=<fourni automatiquement par le store Vercel Blob>
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=<cle Google AI Studio>
# RENDER_MODE, REALTIME, STORAGE_DRIVER et PUBLIC_CACHE_SECONDS prennent
# automatiquement les valeurs adaptees au serverless.
