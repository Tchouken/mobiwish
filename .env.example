# --- Serveur ---
PORT=3000
# URL publique de l'evenement : sert a generer le QR code affiche sur place
PUBLIC_URL=http://localhost:3000

# --- Securite ---
# Secret de signature des sessions participants (obligatoire en production)
SESSION_SECRET=change-me-please
# Code d'acces a la console d'administration (/admin) et a l'ecran (/display)
ADMIN_TOKEN=leboncoin2026
# Code d'acces optionnel a la borne (/kiosk). Vide = borne ouverte.
KIOSK_TOKEN=

# --- Generation d'images ---
# mock    : images generees localement (aucune cle, ideal demo / tests / repli)
# openai  : API images OpenAI (gpt-image-1)
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# Style applique a toutes les images generees (charte graphique de l'evenement)
# Repli automatique sur le generateur local si l'API distante echoue (1 = oui)
IMAGE_FALLBACK_MOCK=1
IMAGE_STYLE=illustration editoriale moderne, formes geometriques simples, aplats de couleurs vives dominante orange, fond clair, sans texte

# --- Stockage ---
DATA_DIR=./data
